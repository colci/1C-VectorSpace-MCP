# Пример настроек для работы с Memgraph

# Чтение графа MCP-сервером:
# - json: читать из локального graph_cache_*.json
# - memgraph: читать из Memgraph через Bolt
GRAPH_BACKEND=memgraph

# Куда индексатор пишет graph projection:
# - json
# - memgraph
# - json,memgraph  -> dual-write
GRAPH_WRITE_TARGETS=json,memgraph

# Подключение к Memgraph
MEMGRAPH_URI=bolt://localhost:7687
# Для локального docker-compose без auth оставьте пустыми.
# Если auth включен отдельно, задайте нужные значения.
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=
MEMGRAPH_DATABASE=
MEMGRAPH_BATCH_SIZE=1000
MEMGRAPH_RETRY_ATTEMPTS=3
MEMGRAPH_RETRY_BACKOFF_SECONDS=2
