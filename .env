EXPORT_PATH=D:\Export\UNF
QDRANT_URL=http://localhost:6333

# Настройки оптимизации производительности и памяти
INDEX_BATCH_SIZE=100
FASTEMBED_THREADS=4
MAX_RAM_PERCENT=90

# Выбор модели эмбеддингов (раскомментируйте нужную строку)
# 1. Тяжелая и точная модель (по умолчанию, медленная на CPU)
#EMBEDDING_MODEL=intfloat/multilingual-e5-large
# 2. Легкая и быстрая модель (рекомендуется для оффлайн CPU)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# API Ключ для OpenAI (если используется, то локальные модели FastEmbed отключаются)
# OPENAI_API_KEY=your_openai_api_key_here
